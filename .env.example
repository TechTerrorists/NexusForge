# ──────────────────────────────────────────────
# NexusForge Environment Configuration
# Copy this to .env and fill in your values
# ──────────────────────────────────────────────

# ── Database ──
DB_ASYNC_URL=postgresql+asyncpg://nexusforge:nexusforge_secret@localhost:5432/nexusforge
DB_SYNC_URL=postgresql://nexusforge:nexusforge_secret@localhost:5432/nexusforge

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Auth ──
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECRET_KEY=CHANGE_ME

# ── App ──
NEXUSFORGE_ENVIRONMENT=development
NEXUSFORGE_DEBUG=true
NEXUSFORGE_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── OpenCode Runner (required for task execution) ──
# Build the runner once: docker build -f docker/Dockerfile.runner -t nexusforge-opencode-runner:latest .
NEXUSFORGE_RUNNER_MODE=docker
NEXUSFORGE_RUNNER_IMAGE=nexusforge-opencode-runner:latest

# OpenCode 1.18+ stores TUI credentials in a local SQLite database. Do not
# copy that database into containers. Put your OpenCode Zen API key here;
# NexusForge creates a temporary runner-only config from it.
NEXUSFORGE_OPENCODE_API_KEY=

# Run `opencode models` after logging in, then use its exact provider/model
# identifier (for example: opencode/gpt-5.6-terra).
NEXUSFORGE_OPENCODE_MODEL=opencode/gpt-5.6-terra

# Optional legacy credential transport for older OpenCode auth-file layouts.
OPENCODE_AUTH_JSON_B64=

# The API container and Docker daemon must both see these paths unchanged.
# Register repositories using paths under NEXUSFORGE_HOST_PROJECTS_ROOT.
NEXUSFORGE_HOST_PROJECTS_ROOT=/home/sunjeet/projects
NEXUSFORGE_HOST_RUNS_ROOT=/home/sunjeet/projects/nexusforge-runs
# If agency-agents is a sibling of nexusforge, leave this as ../../agency-agents.
NEXUSFORGE_HOST_AGENCY_AGENTS=../../agency-agents
